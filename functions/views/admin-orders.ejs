<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex, nofollow, noarchive" />
        <title>The Fang Farm</title>
        <link rel="icon" href="/icon.svg" type="image/svg+xml" />
        <link
            rel="icon"
            href="/favicon-32x32.png"
            type="image/png"
            sizes="32x32"
        />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="apple-touch-icon" href="/apple-touch-icon-180x180.png" />
        <link rel="manifest" href="/manifest.json" />
        <!-- styles -->
        <link rel="stylesheet" href="styles/admin-orders.css">
    </head>
    <body>

        <%- include("./modules/admin-nav.ejs") %> 
        
        <header>
            <h1>Manage Orders</h1>
            <span>
                <a href="https://app.squareup.com/dashboard/orders/overview" class="btn btn-secondary">Open in Square</a>
                <button id="button-sync-with-square-orders" class="btn btn-primary">Sync with Square</button>
            </span>
        </header>
        <main>
            <!-- existing -->
            <table>
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th aria-label="action"></th>
                    </tr>
                </thead>
                <tbody>
                    <% orders.forEach((o) => { %>
                        <%
                            const fulfillment = o?.fulfillments?.[0];
                            const details = fulfillment?.shipmentDetails || fulfillment?.pickupDetails;
                            const recipient = details?.recipient;
                            const annotationRowId = (o?.fulfillments?.length > 1) ? Math.random().toString(36) : undefined;
                        %>

                        <tr<% if (annotationRowId) { %> aria-describedby="<%= annotationRowId %>"<% } %>>
                            <td><%= o?.id %></td>
                            <td><%= fulfillment?.type %></td>
                            <td><%= fulfillment?.state %></td>
                            <td><%= recipient?.displayName %></td>
                            <td><%= recipient?.phoneNumber %></td>
                            <td><button type="button" class="btn btn-secondary">View</button></td>
                        </tr>

                        <% if (annotationRowId) { %>
                            <tr id="<%= annotationRowId %>" class="annotation">
                                <td colspan="9">
                                    <b icon="class">warning</b>
                                    <span>This order includes multiple fulfillments.</span>
                                    <a href="">Open in Square<i class="icon">open_in_new</i></a></td>
                            </tr>
                        <% } %>
                    <% }); %>
                </tbody>
            </table>
            <!-- create new -->
            <button type="button" class="btn btn-primary">Create New Order</button>
        </main>

        <dialog id="dialog-order">
            <form id="form-order">
                <section id="order-details" aria-label="order details">
                    <label>
                        <span>Order</span>
                        <input type="text" name="id" class="form-control">
                    </label>
                    <label>
                        <span>Type</span>
                        <select name="type" class="form-control">
                            <option value="PICKUP">PICKUP</option>
                            <option value="SHIPMENT">SHIPMENT</option>
                        </select>
                    </label>
                </section>

                <section id="recipient-details" aria-labelledby="order-edit-recipient">
                    <h3 id="order-edit-recipient">Recipient Details</h3>
                    <label>
                        <span>Name</span>
                        <input type="text" name="givenName" class="form-control">
                    </label>
                    <label>
                        <span>Address</span>
                        <input type="text" name="addressLine1" class="form-control">
                    </label>
                    <label>
                        <span>Unit</span>
                        <input type="text" name="addressLine2" class="form-control">
                    </label>
                    <label>
                        <span>City</span>
                        <input type="text" name="locality" class="form-control">
                    </label>
                    <label>
                        <span>State</span>
                        <input type="text" name="administrativeDistrictLevel1" class="form-control">
                    </label>
                    <label>
                        <span>ZIP</span>
                        <input type="text" name="postalCode" class="form-control">
                    </label>
                </section>

                <section id="shipping-details" aria-labelledby="order-edit-shipping">
                    <h3 id="order-edit-shipping">Shipping Details</h3>
                    <template id="order-shipment-template">
                        <div class="shipment">
                            <h4>Box</h4>
                            <fieldset>
                                <legend>Dimensions</legend>
                                <label>
                                    <span>Length</span>
                                    <input type="number" name="length" class="form-control">
                                </label>
                                <label>
                                    <span>Width</span>
                                    <input type="number" name="width" class="form-control">
                                </label>
                                <label>
                                    <span>Height</span>
                                    <input type="number" name="height" class="form-control">
                                </label>
                            </fieldset>
                            <fieldset>
                                <legend>Weight</legend>
                                <!-- weight is calculated -->
                                <input type="hidden" name="weight">
                                <!-- based on pounds and ounces -->
                                <label>
                                    <span>Pounds</span>
                                    <input type="number" name="pounds" class="form-control">
                                </label>
                                <label>
                                    <span>Ounces</span>
                                    <input type="number" name="ounces" class="form-control">
                                </label>
                            </fieldset>
                            <label>
                                <span>Service</span>
                                <select name="service" class="form-control">
                                    <option value="01">UPS Next Day Air</option>
                                    <option value="02">UPS 2nd Day Air</option>
                                    <option value="12">UPS 3 Day Select</option>
                                    <option value="03">UPS Ground</option>
                                </select>
                            </label>
                            <fieldset>
                                <legend>Items</legend>
                                <ul class="shipment-item-list"></ul>
                            </fieldset>
                            <button type="button" class="btn btn-secondary">Print Label</button>
                        </div>
                    </template>
                </section>

                <section id="pickup-details" aria-labelledby="order-edit-pickup">
                    <h3 id="order-edit-pickup">Pickup Details</h3>
                    <template id="order-pickup-template">
                        <div class="pickup"></div>
                    </template>
                </section>

                <button type="submit" class="btn btn-primary">Save Order</button>

                <button type="button" popovertarget="order-editor-menu" aria-label="more options" class="btn btn-secondary icon">more_vert</button>
                <menu id="order-editor-menu" popover>
                    <li><button type="button" class="btn btn-secondary">Open in Square</button></li>
                </menu>
            </form>
        </dialog>
        <script src="/scripts/admin-orders.min.js"></script>
    </body>
</html>