{
    "firestore": {
        "database": "(default)",
        "location": "us-east1",
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "disallowLegacyRuntimeConfig": true,
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log",
                "*.local"
            ],
            "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run lint"]
        }
    ],
    "hosting": [
        {
            "target": "public-site",
            "public": "public",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**",
                "**/*.scss",
                "**/*.sass",
                "**/*.ts",
                "**/*.mjs",
                "**/*.map",
                "**/*!(min).js"
            ],
            "rewrites": [
                {
                    "source": "/catalog_images/**",
                    "cloudStorage": {
                        "bucket": "thepodpro.appspot.com"
                    }
                },
                {
                    "source": "/**",
                    "function": "publicApp"
                }
            ]
        },
        {
            "target": "admin-site",
            "public": "public",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**",
                "**/*.scss",
                "**/*.sass",
                "**/*.ts",
                "**/*.mjs",
                "**/*.map",
                "**/*!(min).js"
            ],
            "rewrites": [
                {
                    "source": "/**",
                    "function": "adminApp"
                }
            ]
        }
    ],
    "storage": {
        "rules": "storage.rules"
    }
}
